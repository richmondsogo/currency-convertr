{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": false,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/ui/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "phosphor",
  "aliases": {
    "components": "@/ui/components",
    "utils": "@/ui/lib/utils",
    "ui": "@/ui/components/ui",
    "lib": "@/ui/lib",
    "hooks": "@/ui/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@cultui": "https://www.cult-ui.com/r/{name}.json",
    "@shadcnblocks": "https://shadcnblocks.com/r/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@pouf": "https://1st-pouf.worksonmy.dev/r/{name}.json",
    "@prompt-kit": "https://www.prompt-kit.com/c/{name}.json"
  }
}
